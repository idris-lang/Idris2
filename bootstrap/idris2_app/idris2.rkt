(define (blodwen-force-lazy e)
  (let ((exval (weak-box-value (mcar e) bwp)))
    (if (eq? exval bwp)
      (let ((val ((mcdr e))))
        (begin (set-mcar! e (make-weak-box val)) val))
      exval)))

(define (blodwen-toSignedInt x bits)
